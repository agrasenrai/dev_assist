# Copy to .env.deploy. Never commit the populated file.
# ECR image tag/digest for deploy/compose.ec2.yaml; fill after building the new image.
APP_IMAGE=
DOMAIN=shiftweave.example.com
PUBLIC_ORIGIN=https://shiftweave.example.com
MCP_AUTH_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_32_BYTE_SECRET
# For the provisioned staff profile, enable this and preserve its existing secret/database.
STAFF_AUTH_REQUIRED=false
SANDBOX_SESSION_SECRET=
EPIC_CREATE_REVIEW_TASKS=true
LLM_PROVIDER=bedrock
SIMULATION_MODE=false
# Production requires Bedrock. Keep the free mock provider for local development only.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Prefer an EC2 IAM role. For temporary credentials, supply all three values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Optional Epic backend app, approved synthetic patient IDs only.
EPIC_CLIENT_ID=
EPIC_KID=
EPIC_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_TEST_PATIENT_IDS=
PRIVATE_KEY_PASSPHRASE=
EPIC_READS_ENABLED=false
EPIC_WRITES_ENABLED=false
# Optional hosted synthetic hospital in the SAME configured SQLite file.
# Explicitly provision it before enabling this flag. External MCP still defaults Epic.
HOSPITAL_SIMULATION_ENABLED=false
HOSPITAL_DATA_SOURCE=sqlite
# Only needed if deliberately using the optional external FHIR deployment.
HOSPITAL_FHIR_BASE_URL=
HOSPITAL_FHIR_TOKEN=
# Select a release/digest verified on your EC2 architecture; do not use latest.
HAPI_FHIR_IMAGE=
HOSPITAL_POSTGRES_PASSWORD=

# Needed only for initial Epic sync before nurse/patient mappings exist.
# Use existing, non-synthetic nurse/shift IDs; never guess IDs from display names.
EPIC_DEMO_NURSE_ID=
EPIC_DEMO_SHIFT_ID=

# Optional server-side streaming speech; preserve your current approved voice.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
