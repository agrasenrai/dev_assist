# Server Configuration
PORT=3000
MCP_ENDPOINT=/mcp

# SQLite Database
SQLITE_DB_PATH=./data/shiftweave.db

# Teammate Data Ingestion Directory
INCOMING_DATA_DIR=./data/incoming

# AI / LLM Configuration (Options: 'gemini', 'mock', 'bedrock')
LLM_PROVIDER=mock
GEMINI_API_KEY=

# AWS Bedrock (Optional Mini-Challenge)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional model selection; no external provider is required locally
GEMINI_MODEL=gemini-2.5-flash
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# External transport configuration only; hospital operational mapping is not yet enabled
FHIR_BASE_URL=
FHIR_ACCESS_TOKEN=

# Epic on FHIR Sandbox Configuration (Step 1 Completed)
EPIC_CLIENT_ID=ccc8c11f-4af0-4caf-b981-848012aab1a2
PRIVATE_KEY_PATH=./keys/private_key.pem
EPIC_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_JWKS_URL=https://agrasenrai.github.io/epic-sandbox-jwks/jwks.json
EPIC_SMART_SCOPE_VERSION=v2
EPIC_FHIR_ID_SCHEME=unconstrained

