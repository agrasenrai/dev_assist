# Server Configuration
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=
DEMO_USER=
DEMO_PASSWORD=
MCP_AUTH_TOKEN=
MCP_ENDPOINT=/mcp

# SQLite Database
SQLITE_DB_PATH=./data/shiftweave.db

# Teammate Data Ingestion Directory
INCOMING_DATA_DIR=./data/incoming

# AI / LLM Configuration (Options: 'gemini', 'mock', 'bedrock')
LLM_PROVIDER=mock
GEMINI_API_KEY=

# AWS Bedrock (Optional Mini-Challenge)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional model selection; no external provider is required locally
GEMINI_MODEL=gemini-2.5-flash
BEDROCK_MODEL_ID=
LLM_MAX_OUTPUT_TOKENS=1024

# External transport configuration only; hospital operational mapping is not yet enabled
FHIR_BASE_URL=
FHIR_ACCESS_TOKEN=

# Optional Epic backend configuration; presence is not verified access
EPIC_CLIENT_ID=
EPIC_KID=
EPIC_READS_ENABLED=false
EPIC_WRITES_ENABLED=false
EPIC_TEST_PATIENT_IDS=
PRIVATE_KEY_PATH=./keys/private_key.pem
PRIVATE_KEY_PASSPHRASE=
EPIC_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
# Register your matching public JWKS URL with Epic; never publish the private key.
EPIC_JWKS_URL=
EPIC_SMART_SCOPE_VERSION=v2
EPIC_FHIR_ID_SCHEME=unconstrained

