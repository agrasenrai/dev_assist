# Server Configuration
PORT=3000
MCP_ENDPOINT=/mcp

# SQLite Database
SQLITE_DB_PATH=./data/shiftweave.db

# Teammate Data Ingestion Directory
INCOMING_DATA_DIR=./data/incoming

# AI / LLM Configuration (Options: 'gemini', 'mock', 'bedrock')
LLM_PROVIDER=mock
GEMINI_API_KEY=

# AWS Bedrock (Optional Mini-Challenge)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional model selection; no external provider is required locally
GEMINI_MODEL=gemini-2.5-flash
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# External transport configuration only; hospital operational mapping is not yet enabled
FHIR_BASE_URL=
FHIR_ACCESS_TOKEN=
