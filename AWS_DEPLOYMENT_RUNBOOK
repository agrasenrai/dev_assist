## 17. Create the production Compose file

Copy the project deployment files to:

```text
/opt/shiftweave
```

The production Compose configuration should use the ECR image and EBS bind mounts.

Example:

```yaml
services:
  app:
    image: ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/shiftweave:2026-10-22-001
    env_file:
      - .env.deploy
    environment:
      NODE_ENV: production
      HOST: 0.0.0.0
      PORT: 3000
      SQLITE_DB_PATH: /app/storage/shiftweave.db
      PRIVATE_KEY_PATH: /run/epic/private_key.pem
    volumes:
      - /mnt/shiftweave/storage:/app/storage
      - /mnt/shiftweave/backups:/app/backups
      - /mnt/shiftweave/keys:/run/epic:ro
    restart: unless-stopped
    init: true
    stop_grace_period: 30s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

  https:
    image: caddy:2
    env_file:
      - .env.deploy
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./deploy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    depends_on:
      app:
        condition: service_healthy
    restart: unless-stopped

volumes:
  caddy-data:
  caddy-config:
```

Replace:

```text
ACCOUNT_ID
REGION
2026-10-22-001
```

with real values.

The application has one replica. Do not add:

```yaml
deploy:
  replicas: 2
```

