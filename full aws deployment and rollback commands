# Step 10 — Verify MCP

Use the MCP token without printing it:

```powershell
$region = "us-west-2"

$mcpToken = aws ssm get-parameter `
  --name "/shiftweave/production/MCP_AUTH_TOKEN" `
  --with-decryption `
  --region $region `
  --query "Parameter.Value" `
  --output text

$headers = @{
  Authorization = "Bearer $mcpToken"
  Accept = "application/json, text/event-stream"
  "Content-Type" = "application/json"
  "MCP-Protocol-Version" = "2025-11-25"
}

$body = @{
  jsonrpc = "2.0"
  id = 1
  method = "initialize"
  params = @{
    protocolVersion = "2025-11-25"
    capabilities = @{
      tools = @{
        listChanged = $false
      }
    }
    clientInfo = @{
      name = "shiftweave-deployment-check"
      version = "1.0.0"
    }
  }
} | ConvertTo-Json -Depth 10 -Compress

$response = Invoke-WebRequest `
  -UseBasicParsing `
  -Method Post `
  -Uri "http://32.189.84.182/mcp" `
  -Headers $headers `
  -Body $body

Write-Host "MCP_STATUS=$($response.StatusCode)"
Write-Host "MCP_SESSION_ID=$($response.Headers["mcp-session-id"])"
Write-Host $response.Content
```

Expected:

```text
MCP_STATUS=200
```

and:

```text
protocolVersion: 2025-11-25
```

