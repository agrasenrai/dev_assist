# Step 5 — Back up the live SQLite database

Run:

```powershell
$commands = @(
  'set -eu',
  'STAMP=$(date -u +%Y%m%dT%H%M%SZ)',
  'BACKUP="/app/backups/shiftweave-$STAMP.db"',
  'docker exec shiftweave-app-1 node --input-type=commonjs -e "const Database=require(\"better-sqlite3\"); const db=new Database(\"/app/storage/shiftweave.db\",{readonly:true}); db.backup(process.argv[1]).then(()=>{db.close(); console.log(process.argv[1])}).catch(e=>{console.error(e.message); process.exit(1)})" "$BACKUP"',
  'BACKUP_FILE=$(find /mnt/shiftweave/backups -maxdepth 1 -type f -name "shiftweave-*.db" -printf "%T@ %p\n" | sort -n | tail -1 | cut -d" " -f2-)',
  'test -n "$BACKUP_FILE"',
  'aws s3 cp "$BACKUP_FILE" "s3://shiftweave-backups-540087632943-us-west-2/shiftweave/$(basename "$BACKUP_FILE")" --sse AES256 --region us-west-2',
  'aws s3api head-object --bucket shiftweave-backups-540087632943-us-west-2 --key "shiftweave/$(basename "$BACKUP_FILE")" --region us-west-2 --query "{Size:ContentLength,ETag:ETag,Encryption:ServerSideEncryption,VersionId:VersionId}" --output json'
)

@{commands=$commands} |
  ConvertTo-Json -Compress |
  Set-Content -Path .\ssm-backup-before-update.json -Encoding ascii

$commandId = aws ssm send-command `
  --instance-ids i-08e66aa7d1bdd0c6c `
  --document-name AWS-RunShellScript `
  --parameters file://ssm-backup-before-update.json `
  --comment "Backup ShiftWeave SQLite before application update" `
  --region us-west-2 `
  --query "Command.CommandId" `
  --output text

Write-Host "CommandId: $commandId"

aws ssm wait command-executed `
  --command-id $commandId `
  --instance-id i-08e66aa7d1bdd0c6c `
  --region us-west-2

aws ssm get-command-invocation `
  --command-id $commandId `
  --instance-id i-08e66aa7d1bdd0c6c `
  --region us-west-2 `
  --query "{Status:Status,ResponseCode:ResponseCode,Output:StandardOutputContent,Error:StandardErrorContent}" `
  --output json

Remove-Item .\ssm-backup-before-update.json -Force
```

Expected:

```json
{
    "Status": "Success",
    "ResponseCode": 0
}
```

The output should include:

```text
Encryption: AES256
VersionId: ...
```

Do not deploy if the backup fails.

